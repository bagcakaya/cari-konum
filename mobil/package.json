    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "postinstall": "node -e \"const fs=require('fs'),p='./node_modules/expo-notifications/build/warnOfExpoGoPushUsage.js';if(fs.existsSync(p)){let c=fs.readFileSync(p,'utf8');c=c.replace('throw new Error(message);','didWarn=true;console.warn(message);');fs.writeFileSync(p,c,'utf8');}\""
  },
