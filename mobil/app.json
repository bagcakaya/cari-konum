{
  "expo": {
    "name": "CariRadar",
    "slug": "cari-radar",
    "owner": "edutakip",
    "scheme": "cariradar",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0f172a",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.edutakip.cariradar",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "En yakın carileri harita üzerinde görmek ve saha takibi yapmak için konum izni gereklidir.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Uygulama kapalıyken de belirlediğiniz mesafedeki carilere yaklaştığınızda bildirim alabilmeniz için arka plan konum izni gereklidir.",
        "UIBackgroundModes": [
          "location",
          "fetch"
        ]
      }
    },
    "android": {
      "package": "com.edutakip.cariradar",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#0f172a",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS",
        "WAKE_LOCK",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "CariRadar kapalıyken dahi yaklaştığınız firmaları bildirebilmek için arka plan konum iznine ihtiyaç duyar."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#10b981"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "780fdf09-d817-4209-b87a-596d55d92b12"
      }
    }
  }
}
